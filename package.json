{
  "name": "auth-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.tools.json",
    "stack:dev": "docker compose -f ../stack/compose.yml stop auth-service && docker compose -f ../stack/compose.yml --profile dev up -d --build auth-service-dev",
    "stack:stop": "docker compose -f ../stack/compose.yml --profile dev stop auth-service-dev && docker compose -f ../stack/compose.yml up -d auth-service",
    "stack:logs": "docker compose -f ../stack/compose.yml --profile dev logs -f --tail 50 auth-service-dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "auth:generate": "cross-env AUTH_SCHEMA_GENERATION=1 auth generate --config server/lib/auth.ts --output server/lib/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "seed:clients": "tsx --env-file-if-exists=.env scripts/seed-clients.ts",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@better-auth/passkey": "1.7.6",
    "@vueuse/core": "^15.0.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-vue-next": "^1.0.0",
    "nodemailer": "^10.0.12",
    "nuxt": "^4.5.2",
    "pg": "^8.23.0",
    "reka-ui": "^2.10.5",
    "shadcn-nuxt": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "auth": "1.7.6",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jose": "^6.2.12",
    "prettier": "^3.9.9",
    "semantic-release": "^25.0.9",
    "semantic-release-gitmoji": "^1.6.9",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
